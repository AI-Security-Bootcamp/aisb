# Copy this file to .env in this folder and fill in your OpenRouter key.
# A key in the repository-root .env also works; local values take precedence.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROVIDER=deepinfra
OPENROUTER_QUANTIZATION=fp8
